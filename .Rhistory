library(lubridate) # Make sure lubridate is loaded for date handling
# 1. Load measurements (this might take a few seconds due to file size)
measurements <- read_csv("measurements.csv")
# 2. Filter for NO2 and a single year (e.g., 2023) to keep it manageable
no2_2023 <- measurements %>%
filter(species == "NO2") %>%
mutate(datetime = ymd_hms(datetime),
year = year(datetime)) %>%
filter(year == 2023)
# 2. Filter for NO2 and a single year (e.g., 2023) to keep it manageable
no2_2023 <- measurements %>%
filter(species == "NO2") %>%
mutate(datetime = ymd_hms(datetime),
year = year(datetime)) %>%
filter(year == 2023)
# 3. Join the filtered measurements with your site types
air_quality_joined <- no2_2023 %>%
inner_join(sites, by = "site_code")
# 4. Check a summary of your joined dataset
head(air_quality_joined)
table(air_quality_joined.site_type = air_quality_joined$site_type)
